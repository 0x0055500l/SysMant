# Configuracion local del servidor. Destino: backend/.env.
NODE_ENV=development

# Conexion MySQL.
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=sysmant
DB_USER=sysmant_app
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=50
DB_CONNECT_TIMEOUT_MS=10000

# API HTTP.
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Clave generada por env:setup.
JWT_SECRET=
JWT_ISSUER=sysmant-local
JWT_AUDIENCE=sysmant-api
JWT_EXPIRES_IN_SECONDS=3600

# Programacion UTC y sincronizacion remota.
CRON_ALERTAS_SCHEDULE="0 * * * *"
AZURE_SYNC_ENABLED=false
AZURE_API_URL=
AZURE_SYNC_API_KEY=
CRON_SYNC_SCHEDULE="*/30 * * * *"
AZURE_SYNC_PATH=api/sincronizacion/recibir
AZURE_SYNC_TIMEOUT_MS=10000
AZURE_SYNC_BATCH_SIZE=100
AZURE_SYNC_ALLOW_LOCAL_HTTP=false
# SYSMANT_STATION_ID: UUID de instalacion generado por env:setup.
