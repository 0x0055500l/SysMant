# Copiar a backend/.env. Este archivo de ejemplo si se versiona.
NODE_ENV=development

# Usuario del motor MySQL, distinto al administrador de la aplicacion.
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=sysmant
DB_USER=sysmant_app
DB_PASSWORD="REEMPLAZAR_CON_UNA_CLAVE_PROPIA"
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=50
DB_CONNECT_TIMEOUT_MS=10000

# API HTTP local (puerto distinto del puerto de MySQL).
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# npm run env:setup genera esta clave localmente sin mostrarla.
JWT_SECRET="REEMPLAZAR_CON_CLAVE_ALEATORIA"
JWT_ISSUER=sysmant-local
JWT_AUDIENCE=sysmant-api
JWT_EXPIRES_IN_SECONDS=3600

# Fase 3: tareas en UTC. Azure permanece apagado hasta configurar el VPS.
CRON_ALERTAS_SCHEDULE="0 * * * *"
AZURE_SYNC_ENABLED=false
AZURE_API_URL=
AZURE_SYNC_API_KEY=
CRON_SYNC_SCHEDULE="*/30 * * * *"
AZURE_SYNC_PATH=api/sincronizacion/recibir
AZURE_SYNC_TIMEOUT_MS=10000
AZURE_SYNC_BATCH_SIZE=100
AZURE_SYNC_ALLOW_LOCAL_HTTP=false
# env:setup agrega SYSMANT_STATION_ID con un UUID unico por instalacion.
