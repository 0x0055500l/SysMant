server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    server_tokens off;
    client_max_body_size 1m;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/sysmant-acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location /api/ {
        return 503;
    }

    location = / {
        default_type text/plain;
        return 200 "SysMant Cloud\n";
    }

    location / { return 404; }
}
