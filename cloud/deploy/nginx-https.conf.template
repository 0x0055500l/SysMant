server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/sysmant-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 308 https://__DOMAIN__$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __DOMAIN__;
    server_tokens off;
    ssl_certificate __PROJECT_ROOT__/private/tls/fullchain.pem;
    ssl_certificate_key __PROJECT_ROOT__/private/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SYSMANT_SSL:1m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    client_max_body_size 1m;
    client_body_timeout 15s;
    client_header_timeout 10s;
    send_timeout 15s;
    keepalive_timeout 15s;
    limit_conn sysmant_connections 20;
    limit_req zone=sysmant_global burst=40 nodelay;
    limit_req_status 429;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    location = /api/supervision/auth/login {
        limit_req zone=sysmant_global burst=40 nodelay;
        limit_req zone=sysmant_login_global burst=3 nodelay;
        limit_req zone=sysmant_login burst=5 nodelay;
        limit_req_status 429;
        client_max_body_size 8k;
        include __PROJECT_ROOT__/deploy/nginx-portal-proxy.conf;
    }

    location ^~ /api/supervision/ {
        limit_req zone=sysmant_global burst=40 nodelay;
        limit_req zone=sysmant_api burst=20 nodelay;
        limit_req_status 429;
        client_max_body_size 8k;
        include __PROJECT_ROOT__/deploy/nginx-portal-proxy.conf;
    }

    location ^~ /api/sincronizacion/ {
        include __PROJECT_ROOT__/private/station-networks.conf;
        limit_req zone=sysmant_global burst=40 nodelay;
        limit_req zone=sysmant_api burst=20 nodelay;
        limit_req_status 429;
        include __PROJECT_ROOT__/deploy/nginx-portal-proxy.conf;
    }

    location /api/ {
        limit_req zone=sysmant_global burst=40 nodelay;
        limit_req zone=sysmant_api burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 12s;
        proxy_send_timeout 12s;
    }

    location = / {
        return 302 /supervision/;
    }
    location = /supervision { return 302 /supervision/; }
    location ^~ /supervision/ {
        include __PROJECT_ROOT__/deploy/nginx-portal-proxy.conf;
    }
    location / { return 404; }
}
