{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json", "version": 1,
  "cli": { "analytics": false }, "newProjectRoot": "projects",
  "projects": {
    "supervision": {
      "projectType": "application", "root": "", "sourceRoot": "src", "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/sysmant-supervision", "index": "src/index.html", "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json", "inlineStyleLanguage": "scss", "baseHref": "/supervision/",
            "assets": [{ "glob": "**/*", "input": "public" }], "styles": ["src/styles.scss"]
          },
          "configurations": {
            "production": {
              "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": false },
              "outputHashing": "all", "sourceMap": false,
              "budgets": [{ "type": "initial", "maximumWarning": "750kB", "maximumError": "950kB" }]
            },
            "development": { "optimization": false, "sourceMap": true }
          }, "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "supervision:build:development" } },
        "test": { "builder": "@angular/build:unit-test", "options": { "tsConfig": "tsconfig.spec.json", "runner": "vitest", "include": ["src/**/*.spec.ts"] } }
      }
    }
  }
}
