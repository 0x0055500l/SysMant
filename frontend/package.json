{
  "name": "sysmant-frontend",
  "version": "0.5.0",
  "private": true,
  "description": "SysMant: autenticación, dashboard e inventario para la gestión local de mantenimiento",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host localhost --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
